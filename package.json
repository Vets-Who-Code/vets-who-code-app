{
  "name": "vets-who-code",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "preinstall": "npx only-allow npm",
    "dev": "next dev",
    "dev:setup": "prisma generate && prisma db push",
    "build": "tsx src/scripts/generate-swagger-spec.ts && next build",
    "analyze": "ANALYZE=true npm run build",
    "vercel-build": "prisma migrate deploy && prisma generate && tsx src/scripts/generate-swagger-spec.ts && next build && next-sitemap",
    "start": "next start",
    "export": "next build && next export",
    "format": "biome format --write",
    "clean": "rimraf *.tsbuildinfo .next out",
    "clean-all": "rimraf *.tsbuildinfo node_modules .husky .next out",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome lint",
    "lint:fix": "npm run typecheck && biome check --write",
    "prepare": "husky install",
    "postbuild": "next-sitemap",
    "check": "biome ci",
    "security:audit": "npm audit",
    "security:check": "npm audit --omit=dev --audit-level=high",
    "security:fix": "npm audit fix",
    "test": "vitest run",
    "generate:blog-audio": "tsx -r dotenv/config scripts/generate-blog-audio-overviews.ts",
    "commitlint": "commitlint --from-HEAD~1",
    "generate:blog-graphic": "tsx -r dotenv/config scripts/generate-blog-graphic.ts",
    "generate:blog-image": "tsx -r dotenv/config scripts/generate-blog-image.ts",
    "generate:blog-media": "tsx -r dotenv/config scripts/generate-blog-media.ts",
    "generate:job-codes": "tsx scripts/parse-job-codes.ts",
    "generate:cognitive-skills": "tsx -r dotenv/config scripts/generate-cognitive-skills.ts",
    "generate:training-pipeline": "tsx -r dotenv/config scripts/generate-training-pipeline.ts",
    "generate:cert-equivalencies": "tsx -r dotenv/config scripts/generate-cert-equivalencies.ts",
    "generate:military-systems": "tsx -r dotenv/config scripts/generate-military-systems.ts",
    "generate:career-pathways": "tsx -r dotenv/config scripts/generate-career-pathways.ts",
    "generate:tech-pathways": "tsx -r dotenv/config scripts/generate-tech-pathways.ts",
    "generate:curriculum-gap-report": "tsx -r dotenv/config scripts/generate-curriculum-gap-report.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.97",
    "@emotion/is-prop-valid": "^1.4.0",
    "@google/genai": "2.27.0",
    "@prisma/client": "^6.10.1",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-icons": "^1.3.0",
    "@vercel/analytics": "^1.4.1",
    "ace-builds": "^1.44.0",
    "ai": "^5.0.93",
    "axios": "^1.4.0",
    "cloudinary": "2.11.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.16",
    "dotenv": "^18.0.5",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "lucide-react": "^0.378.0",
    "marked": "^4.0.18",
    "motion": "^11.13.3",
    "next": "15.5.27",
    "next-cloudinary": "^6.19.3",
    "next-mdx-remote": "^6.0.0",
    "next-pwa": "^5.6.0",
    "next-seo": "^5.5.0",
    "next-sitemap": "^4.2.3",
    "next-swagger-doc": "^0.5.0",
    "node-html-parser": "^7.0.1",
    "ramda": "~0.32.0",
    "react": "^18.3.1",
    "react-ace": "^11.0.1",
    "react-dom": "^18.3.1",
    "react-email": "^5.1.1",
    "react-hook-form": "^7.89.0",
    "react-simple-typewriter": "^3.0.1",
    "swagger-ui-react": "5.33.1",
    "swiper": "^8.3.1",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.2",
    "@fullhuman/postcss-purgecss": "^4.1.3",
    "@next/bundle-analyzer": "16.3.8",
    "@playwright/test": "^1.49.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-onboarding": "^10.6.1",
    "@storybook/nextjs": "^10.6.1",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/cookie": "^1.0.0",
    "@types/google.maps": "^3.66.5",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/marked": "^4.0.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^18.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-portal": "^4.0.4",
    "@types/swagger-ui-react": "4.18.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.6.1",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^12.3.7",
    "only-allow": "^1.2.2",
    "postcss": "^8.5.29",
    "prisma": "^6.10.1",
    "rimraf": "^6.1.3",
    "storybook": "^10.6.1",
    "tailwindcss": "^3.0.23",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^4.0.18",
    "vitest-dom": "^0.1.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "biome check --write"
  },
  "overrides": {
    "swagger-client": "3.19.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
