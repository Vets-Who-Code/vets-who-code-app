# Copy this file to .env.local and fill in the values you need.
# .env.local and .env are gitignored — never commit them.
#
# Every entry below is annotated:  required|optional · secret|public · consumed by <path>
#   secret = credential; never commit it and never prefix it with NEXT_PUBLIC_
#   public = non-sensitive; NEXT_PUBLIC_* values are inlined into the browser bundle

# Database
# required · secret · consumed by prisma/schema.prisma (env("DATABASE_URL")) and src/pages/api/health.ts
# For local development, use SQLite:
# DATABASE_URL="file:./dev.db"
# For production, use PostgreSQL (Neon, Vercel Postgres, Supabase, etc.):
DATABASE_URL="postgresql://username:password@hostname:port/database"

# NextAuth.js
# required · secret · consumed by src/lib/auth-options.ts — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"
# required · secret · consumed by NextAuth internals and src/pages/api/health.ts
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth (for authentication)
# required · secret · consumed by src/lib/auth-options.ts
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
# required · public · consumed by src/lib/auth-options.ts
# Sign-in requires membership of this GitHub organization — there is no allowlist
# and no dev bypass. To grant someone access, add them to the org.
GITHUB_ORG="Vets-Who-Code"

# GitHub API access (for fetching org data, repos, pull requests)
# optional · secret · consumed by src/lib/git-api-client.ts
GITHUB_TOKEN="your-github-token"

# AI providers (J0d!e teaching assistant, contact-form spam filter, content scripts)
# optional · public · consumed by src/lib/ai-provider.ts — gemini | azure | openai | phi3
PRIMARY_AI_PROVIDER="gemini"

# Google Gemini (recommended for cost-effectiveness)
# optional · secret · consumed by src/lib/ai-provider.ts, src/lib/api-helpers/classify-contact.ts, scripts/generate-*.ts
GOOGLE_GENERATIVE_AI_API_KEY="your-google-ai-api-key"
# optional · secret · same consumers, used as the second fallback Google AI key
GEMINI_API_KEY="your-gemini-api-key"
# optional · secret · script-only · third fallback Google AI key in scripts/generate-*.ts
GOOGLE_PRIVATE_KEY="your-google-ai-api-key"
# optional · public · consumed by src/lib/api-helpers/classify-contact.ts
GEMINI_MODEL="gemini-2.5-flash"
# optional · public · script-only · consumed by scripts/generate-tech-pathways.ts (defaults to gemini-2.0-flash)
TECH_PATHWAYS_MODEL="gemini-2.0-flash"

# Azure OpenAI (GPT-4)
# optional · secret · consumed by src/lib/ai-provider.ts
AZURE_OPENAI_API_KEY="your-azure-openai-key"
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com"
AZURE_OPENAI_DEPLOYMENT="your-gpt4-deployment-name"

# OpenAI (GPT-4)
# optional · secret · consumed by src/lib/ai-provider.ts
OPENAI_API_KEY="your-openai-api-key"

# Phi-3 (local or Azure AI Studio deployment)
# optional · secret · consumed by src/lib/ai-provider.ts
PHI3_ENDPOINT="your-phi3-endpoint"
PHI3_API_KEY="your-phi3-api-key"

# J0dI3 AI backend (server-side only — never prefix with NEXT_PUBLIC_)
# optional · secret · consumed by src/lib/j0di3-client.ts
J0DI3_API_URL=
J0DI3_API_KEY=

# Slack webhooks (form notifications)
# Each value is the path segment appended to https://hooks.slack.com/services/
# optional · secret · consumed by src/pages/api/apply.ts
APPLY_WEBHOOK_ID="T00000000/B00000000/your-webhook-token"
# optional · secret · consumed by src/pages/api/contact.ts
CONTACT_WEBHOOK_ID="T00000000/B00000000/your-webhook-token"
# optional · secret · consumed by src/pages/api/mentor.ts and src/pages/api/mentee.ts (mentee reuses the mentor hook)
MENTOR_WEBHOOK_ID="T00000000/B00000000/your-webhook-token"

# Lightcast (Emsi) - labor market data: salary by SOC, demand, top skills
# Both required for live data; without these, scripts fall back to Census/curated.
# optional · secret · consumed by src/lib/lightcast-client.ts, src/lib/labor-market.ts, scripts/generate-tech-pathways.ts
LIGHTCAST_CLIENT_ID="your-lightcast-client-id"
LIGHTCAST_CLIENT_SECRET="your-lightcast-client-secret"

# US Census ACS - fallback salary data when Lightcast is unavailable
# optional · secret · consumed by src/lib/census-client.ts, src/lib/labor-market.ts
CENSUS_API_KEY="your-census-api-key"

# Shopify Storefront API (for browsing products/cart)
# optional · secret · consumed by src/lib/shopify.ts
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN="your-storefront-access-token"

# Shopify Webhook/API Secrets (REQUIRED for order webhooks - the API Secret Key from API credentials)
# The webhook handler will check for any of these names:
# optional · secret · consumed by src/pages/api/shopify/webhooks/orders/create.ts
SHOPIFY_WEBHOOK_SECRET="your-webhook-secret"     # Primary option
SHOPIFY_API_SECRET="your-api-secret-key"         # Alternative name
SHOPIFY_CLIENT_SECRET="your-client-secret"       # Alternative name

# Cloudinary (for image and audio uploads)
# optional · public · consumed by src/lib/cloudinary.ts, src/lib/cloudinary-helpers.ts, src/lib/blog.ts
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
# optional · secret · consumed by src/lib/cloudinary.ts, src/pages/api/upload/signature.ts, scripts/lib/cloudinary.ts
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Email Service (Resend - for sending certificate emails)
# optional · secret · consumed by src/lib/email.ts
RESEND_API_KEY="your-resend-api-key"
# optional · public · consumed by src/lib/email.ts (custom from address; requires domain verification)
EMAIL_FROM="noreply@vetswhocode.io"

# Public site config
# optional · public · consumed by src/pages/_document.tsx (analytics is skipped when unset)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"
# optional · public · consumed by src/utils/cohort.ts — overrides the default in src/data/site-config.ts
NEXT_PUBLIC_COHORT_START_DATE=""
# optional · public · consumed by next-sitemap.config.js (defaults to https://vetswhocode.io)
NEXT_PUBLIC_SITE_URL="https://vetswhocode.io"
