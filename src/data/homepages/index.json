                            "src": "https://res.cloudinary.com/vetswhocode/image/upload/v1746105264/9_xwkdus.png"
                        }
                    ],
                    "title": "Remote-First",
                    "description": "A computer, internet, and discipline. That's the barrier to entry. We train from anywhere because the military taught us how to operate anywhere.",
                    "path": "/programs",
                    "pathText": "How it works"
                },
                {
                    "id": 2,
                    "images": [
                        {
                            "src": "https://res.cloudinary.com/vetswhocode/image/upload/v1746105263/5_beplkr.png"
                        }
                    ],
                    "title": "Market-Driven Curriculum",
                    "description": "128 Lightcast-validated skills across 25 modules. Every skill maps to actual job postings. If employers aren't hiring for it, we don't teach it.",
                    "path": "/curriculum",
                    "pathText": "See the curriculum"
                },
                {
                    "id": 3,
                    "images": [
                        {
                            "src": "https://res.cloudinary.com/vetswhocode/image/upload/v1746105262/1_tvrmfb.png"
                        }
                    ],
                    "title": "Mentorship, Not Hand-Holding",
                    "description": "Your mentors operate as engineering managers, not tutors. You'll learn to think, debug, and ship under the same pressure you'll face on the job.",
                    "path": "/mentor",
                    "pathText": "Mentor a troop"
                }
            ]
        },
        {
            "section": "funfact-area",
            "section_title": {
                "title": "Who We <span> Are</span>",
                "subtitle": "Built By Veterans,<strong>Measured By Outcomes</strong>",
                "description": "We were founded by veterans who went through the same broken transition pipeline and decided to build something that actually works. Our filter is simple: if it doesn't lead to a job, we don't teach it. Every module in our curriculum maps to skills that employers are actively hiring for, validated against labor market data rather than guesswork. We keep cohorts small, mentorship direct, and outcomes measurable."
            },
            "motto": {
                "text": "Ten years. One way of doing this.",
                "path": "/about-us",
                "pathText": "Read our story"
            },
